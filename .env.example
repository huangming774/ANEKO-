NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sbp_xxxxxxxx

# Used by npm run supabase:types. This is the Supabase Project Reference ID,
# not a password.
SUPABASE_PROJECT_REF=your_project_ref

# Optional: when the login form receives username "admin", the API maps it to this email.
ADMIN_EMAIL=admin@aneko.local

# Cloudflare R2 image uploads
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-r2-domain.example.com

# Optional: Upstash Redis cache（后台设置页「启用 Redis 缓存」开关控制，未配置时自动忽略）
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional: 天地图/广东省地理信息平台 key（活动签到地图用；不填则用 SDK 内置演示 token）
# 在 https://console.tianditu.gov.cn 申请「浏览器端」key
NEXT_PUBLIC_TIANDITU_TOKEN=
